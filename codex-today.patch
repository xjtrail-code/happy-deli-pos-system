+{% block scripts %}
+<script>
+document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
+  button.addEventListener('click', function () {
+    const input = document.getElementById(button.getAttribute('aria-controls'));
+    const show = input.type === 'password';
+    input.type = show ? 'text' : 'password';
+    button.textContent = show ? 'Hide' : 'Show';
+    button.setAttribute('aria-pressed', String(show));
+    const label = input.name === 'confirm_password' ? 'confirm password' : 'password';
+    button.setAttribute('aria-label', (show ? 'Hide ' : 'Show ') + label);
+  });
+});
+document.querySelectorAll('select[name="role"]').forEach(function (select) {
+  function updatePermissions() {
+    const isAdmin = select.value === 'admin';
+    const fieldset = select.form.querySelector('[data-employee-permissions]');
+    fieldset.hidden = isAdmin;
+    fieldset.disabled = isAdmin;
+    select.form.querySelector('[data-admin-access]').hidden = !isAdmin;
+  }
+  select.addEventListener('change', updatePermissions);
+  updatePermissions();
+});
+</script>
